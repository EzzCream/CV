# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://ezzcream.space

# Correo (Resend). Sin RESEND_API_KEY, /api/contact simula el envío en desarrollo.
RESEND_API_KEY=
CONTACT_TO=oscar.7n7@gmail.com
CONTACT_FROM="Portafolio <contacto@ezzcream.space>"

# Cloudflare Turnstile (opcional en desarrollo)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis para el límite de envíos (sin estas variables se usa un límite en memoria)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
